,"k":"invert","w":"s","a":["bta","bubble tip anemone","rose bubble tip anemone","bubble tip"],"g":"anemone"},{"n":"Bucephalandra","s":"Bucephalandra sp.","k":"plant","w":"f","a":["buce","bucephalandra kedagang"]},{"n":"Buenos Aires Tetra","s":"Hemigrammus caudovittatus","k":"fish","w":"f","a":["buenos aires"],"g":"bigtetra"},{"n":"Bumblebee Cichlid","s":"Pseudotropheus crabro","k":"fish","w":"f","a":["bumblebee","crabro"],"g":"cichmal"},{"n":"Bumblebee Goby","s":"Brachygobius doriae","k":"fish","w":"fb","a":["bumble bee goby"]},{"n":"Cabomba","s":"Cabomba caroliniana","k":"plant","w":"f","a":["fanwort"],"g":"stem"},{"n":"Candy Cane Coral","s":"Caulastrea furcata","k":"coral","w":"s","a":["candy cane","trumpet coral","caulastrea"],"g":"lps"},{"n":"Cardinal Tetra","s":"Paracheirodon axelrodi","k":"fish","w":"f","a":["cardinal","cardinals"],"g":"neon"},{"n":"Carpet Anemone","s":"Stichodactyla gigantea","k":"invert","w":"s","a":["carpet"],"g":"anemone"},{"n":"Caulerpa","s":"Caulerpa sp.","k":"plant","w":"s","a":["sea grapes","caulerpa prolifera","grape caulerpa"],"g":"macro"},{"n":"Celestial Pearl Danio","s":"Danio margaritatus","k":"fish","w":"f","a":["galaxy rasbora","cpd"],"g":"danio"},{"n":"Cerith Snail","s":"Cerithium sp.","k":"snail","w":"s","a":["cerith","cerithium"],"g":"reefsnail"},{"n":"Chaetomorpha","s":"Chaetomorpha linum","k":"plant","w":"s","a":["cheato","chaeto","chaeto macroalgae"],"g":"macro"},{"n":"Chalice Coral","s":"Echinophyllia sp.","k":"coral","w":"s","a":["chalice","mycedium","oxypora"],"g":"lps"},{"n":"Cherry Barb","s":"Puntius titteya","k":"fish","w":"f","a":["cherry barbs"],"g":"redbarb"},{"n":"Cherry Shrimp","s":"Neocaridina davidi","k":"shrimp","w":"f","a":["red cherry shrimp","neocaridina","cherry shrimps"],"g":"shrimpf"},{"n":"Cherub Angelfish","s":"Centropyge argi","k":"fish","w":"s","a":["pygmy angelfish"],"g":"angel"},{"n":"Chili Rasbora","s":"Boraras brigittae","k":"fish","w":"f","a":["mosquito rasbora","chili"],"g":"rasbora"},{"n":"Ch